[Unit]
Description=VLYNESS server (anti-censorship transport, research)
Documentation=https://github.com/  (см. docs/DEPLOY.md)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vlyness
Group=vlyness
Environment=VLYNESS_CONFIG=/etc/vlyness/server.toml
ExecStart=/usr/local/bin/vlyness-server
Restart=on-failure
RestartSec=3

# Биндинг 443 без root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Базовый sandboxing.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
# Сертификат читается только на чтение (privkey — через группу vlyness, см. DEPLOY.md §4).
ReadOnlyPaths=/etc/letsencrypt /etc/vlyness

[Install]
WantedBy=multi-user.target
